# Place this file at backend/.env (do not commit real keys).
# The backend loads backend/.env on startup; no PowerShell env commands required.
ENABLE_LLM=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: use a different normalized course catalogue
# SKILLPATH_CATALOG=./data/public_courses.json
# SKILLPATH_DB=./data/feedback.db
